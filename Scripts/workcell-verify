#!/usr/bin/env bash
set -euo pipefail

ARTIFACT_DIR="${WORKCELL_ARTIFACTS_DIR:-test-results/workcell/run-local}"
BASE_URL="${VERIFY_BASE_URL:-https://bitterpass.com}"
BASE_URL="${BASE_URL%/}"
EXPECTED_RELEASE_SHA="${VERIFY_EXPECTED_RELEASE_SHA:-${EXPECTED_GIT_SHA:-}}"
HTTP_REPORT="${ARTIFACT_DIR}/verify-http.json"
SMOKE_JSON="${ARTIFACT_DIR}/smoke-screen.json"
SMOKE_MD="${ARTIFACT_DIR}/SMOKE_SCREEN.md"

mkdir -p "$ARTIFACT_DIR"

python3 - "$BASE_URL" "$ARTIFACT_DIR" "$HTTP_REPORT" "$SMOKE_JSON" "$SMOKE_MD" "$EXPECTED_RELEASE_SHA" <<'PY'
import json
import pathlib
import sys
import time
import urllib.error
import urllib.request

base_url, artifact_dir, http_report, smoke_json, smoke_md, expected_release_sha = sys.argv[1:7]
artifact_root = pathlib.Path(artifact_dir)
checks = []
failures = []
responses = {}


def record(name, ok, **extra):
    checks.append({"name": name, "result": "ok" if ok else "failed", **extra})
    if not ok:
        failures.append(name)


def fetch(key, path):
    url = f"{base_url}{path}"
    body_path = artifact_root / f"verify.{key}.body"
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "BitterPassMarketingWorkcellVerify/1.0"})
        with urllib.request.urlopen(request, timeout=10) as response:
            status = response.status
            body = response.read()
            content_type = response.headers.get("Content-Type", "")
            final_url = response.geturl()
    except urllib.error.HTTPError as exc:
        status = exc.code
        body = exc.read()
        content_type = exc.headers.get("Content-Type", "") if exc.headers else ""
        final_url = exc.geturl()
    except Exception as exc:
        status = 0
        body = f"{type(exc).__name__}: {exc}".encode()
        content_type = ""
        final_url = url

    body_path.write_bytes(body)
    responses[key] = {
        "path": path,
        "url": url,
        "status": status,
        "bytes": len(body),
        "content_type": content_type,
        "final_url": final_url,
        "artifact_ref": str(body_path),
    }
    return status, body.decode("utf-8", errors="replace"), body_path


root_status, root, root_path = fetch("root", "/")
cli_status, cli, cli_path = fetch("cli_setup", "/cli-setup/")
login_status, login, login_path = fetch("login", "/login")
signup_status, signup, signup_path = fetch("signup", "/signup")
robots_status, robots, robots_path = fetch("robots", "/robots.txt")
sitemap_status, sitemap, sitemap_path = fetch("sitemap", "/sitemap.xml")
llms_status, llms, llms_path = fetch("llms", "/llms.txt")
llms_full_status, llms_full, llms_full_path = fetch("llms_full", "/llms-full.txt")
index_md_status, index_md, index_md_path = fetch("index_md", "/index.md")
cli_md_status, cli_md, cli_md_path = fetch("cli_setup_md", "/cli-setup.md")
up_status, up_text, up_path = fetch("up", "/up/")

record("root:status", root_status == 200, status=root_status, artifact_ref=str(root_path))
record("root:title", "BitterPass" in root and "Operator-approved credentials for agents" in root, artifact_ref=str(root_path))
record("root:support_path", "https://bitterdesk.com" in root and "BitterDesk" in root, artifact_ref=str(root_path))
record("root:no_retired_docs_path", "sheetgenius/bitter/blob/main" not in root, artifact_ref=str(root_path))
record("root:authority_framing", "scoped bundles, expiry, revocation, and receipts" in root and "generic password manager" not in root, artifact_ref=str(root_path))
record("root:canonical_metadata", 'href="https://bitterpass.com/"' in root and "https://bitterpass.com/og-image.svg" in root, artifact_ref=str(root_path))

record("cli:status", cli_status == 200, status=cli_status, artifact_ref=str(cli_path))
record("cli:setup_copy", "Set up the BitterPass CLI." in cli and "full CLI walkthrough arrives with your access invitation" in cli, artifact_ref=str(cli_path))
record("cli:console_bridge", "https://app.bitterpass.com" in cli and "https://bitterdesk.com" in cli, artifact_ref=str(cli_path))

record("login:status", login_status == 200, status=login_status, artifact_ref=str(login_path))
record("login:console_bridge", "Sign in through BitterPass Console." in login and "https://app.bitterpass.com/login" in login, artifact_ref=str(login_path))
record("login:account_request", "https://bitter.sh/signup" in login, artifact_ref=str(login_path))

record("signup:status", signup_status == 200, status=signup_status, artifact_ref=str(signup_path))
record("signup:no_local_signup", "There is no BitterPass-only signup path" in signup and "https://bitter.sh/signup" in signup, artifact_ref=str(signup_path))

record("robots:status", robots_status == 200, status=robots_status, artifact_ref=str(robots_path))
record("robots:sitemap", "Sitemap: https://bitterpass.com/sitemap.xml" in robots, artifact_ref=str(robots_path))
record("sitemap:status", sitemap_status == 200, status=sitemap_status, artifact_ref=str(sitemap_path))
record("sitemap:public_routes", "https://bitterpass.com/" in sitemap and "https://bitterpass.com/cli-setup/" in sitemap and "https://bitterpass.com/index.md" in sitemap, artifact_ref=str(sitemap_path))
record("llms:status", llms_status == 200, status=llms_status, artifact_ref=str(llms_path))
record("llms:truth_boundary", "Marketing surface only" in llms and "app.bitterpass.com" in llms, artifact_ref=str(llms_path))
record("llms_full:status", llms_full_status == 200, status=llms_full_status, artifact_ref=str(llms_full_path))
record("llms_full:story_gate", "Claim ledger" in llms_full and "CTA truth" in llms_full, artifact_ref=str(llms_full_path))
record("index_md:status", index_md_status == 200, status=index_md_status, artifact_ref=str(index_md_path))
record("index_md:copy", "operator-approved credential authority" in index_md and "custody boundary" in index_md, artifact_ref=str(index_md_path))
record("cli_md:status", cli_md_status == 200, status=cli_md_status, artifact_ref=str(cli_md_path))
record("cli_md:copy", "invitation-gated" in cli_md and "runner identity" in cli_md, artifact_ref=str(cli_md_path))

try:
    up_payload = json.loads(up_text)
except json.JSONDecodeError:
    up_payload = {}
record("up:ok", up_status == 200 and up_payload.get("ok") is True, status=up_status, artifact_ref=str(up_path))
record("up:service", up_payload.get("service") == "bitterpass.com", service=up_payload.get("service"), artifact_ref=str(up_path))
record("up:hostname", up_payload.get("hostname") == "bitterpass.com", hostname=up_payload.get("hostname"), artifact_ref=str(up_path))
record("up:no_secret_material", up_payload.get("secret_material_returned") is False, artifact_ref=str(up_path))
record("up:release_identity", bool(up_payload.get("git_sha")) and up_payload.get("git_sha") == up_payload.get("release"), git_sha=up_payload.get("git_sha"), release=up_payload.get("release"), artifact_ref=str(up_path))
if expected_release_sha:
    record("up:expected_release", up_payload.get("git_sha") == expected_release_sha, expected=expected_release_sha, observed=up_payload.get("git_sha"), artifact_ref=str(up_path))

report = {
    "schema_version": "bitterpass_marketing.workcell_verify.v1",
    "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "base_url": base_url,
    "expected_release_sha": expected_release_sha,
    "responses": responses,
    "checks": checks,
    "result": "failed" if failures else "ok",
    "failures": failures,
}
pathlib.Path(http_report).write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")

entries = [
    {
        "key": "marketing.front_door",
        "actor": "signed_out_operator",
        "entrypoint": "/",
        "summary": "BitterPass public front door presents agent credential authority, support path, and search metadata without retired docs links.",
        "proves": ["root_http_200", "authority_framing", "support_path", "canonical_metadata"],
        "artifact_refs": [str(root_path), http_report],
        "result": "failed" if any(name.startswith("root:") for name in failures) else "ok",
    },
    {
        "key": "cli_setup",
        "actor": "signed_out_operator",
        "entrypoint": "/cli-setup/",
        "summary": "CLI setup page keeps detailed commands invitation-gated while linking console and support surfaces.",
        "proves": ["cli_setup_http_200", "invitation_gated_copy", "console_bridge", "support_bridge"],
        "artifact_refs": [str(cli_path), http_report],
        "result": "failed" if any(name.startswith("cli:") for name in failures) else "ok",
    },
    {
        "key": "account_bridge",
        "actor": "signed_out_operator",
        "entrypoint": "/login, /signup",
        "summary": "Account paths bridge to BitterPass Console and Bitter account request surfaces instead of local marketing signup.",
        "proves": ["login_http_200", "signup_http_200", "console_login", "no_local_signup"],
        "artifact_refs": [str(login_path), str(signup_path), http_report],
        "result": "failed" if any(name.startswith(("login:", "signup:")) for name in failures) else "ok",
    },
    {
        "key": "public.reader_artifacts",
        "actor": "crawler_or_agent",
        "entrypoint": "/robots.txt, /sitemap.xml, /llms.txt, /llms-full.txt, /index.md, /cli-setup.md",
        "summary": "Crawler and agent-readable artifacts mirror the public story gate and marketing-only boundary.",
        "proves": ["robots", "sitemap", "llms", "markdown_twins"],
        "artifact_refs": [str(robots_path), str(sitemap_path), str(llms_path), str(llms_full_path), str(index_md_path), str(cli_md_path), http_report],
        "result": "failed" if any(name.startswith(("robots:", "sitemap:", "llms:", "llms_full:", "index_md:", "cli_md:")) for name in failures) else "ok",
    },
    {
        "key": "runtime.health_probe",
        "actor": "operator",
        "entrypoint": "/up/",
        "summary": "Static health probe reports BitterPass marketing service identity.",
        "proves": ["health_ok", "service_identity", "release_identity", "no_secret_material"],
        "artifact_refs": [str(up_path), http_report],
        "result": "failed" if any(name.startswith("up:") for name in failures) else "ok",
    },
]
smoke = {
    "schema_version": "bitterpass_marketing.smoke_screen.v1",
    "generated_at": report["generated_at"],
    "base_url": base_url,
    "expected_release_sha": expected_release_sha,
    "entries": entries,
    "limitations": [
        "This verification covers the public marketing and setup surfaces only.",
        "Console login, passkey ceremonies, vault unlock, and credential custody remain owned by app.bitterpass.com and separate authenticated checks."
    ],
    "result": report["result"],
    "failures": failures,
}
pathlib.Path(smoke_json).write_text(json.dumps(smoke, indent=2) + "\n", encoding="utf-8")

lines = [
    "# BitterPass Marketing Smoke Screen",
    "",
    f"- Generated: {smoke['generated_at']}",
    f"- Base URL: {base_url}",
    f"- Expected release SHA: {expected_release_sha or '(not asserted)'}",
    f"- Result: {smoke['result']}",
    "",
]
for entry in entries:
    lines.extend([
        f"## {entry['key']}",
        f"- Actor: {entry['actor']}",
        f"- Entrypoint: {entry['entrypoint']}",
        f"- Summary: {entry['summary']}",
        f"- Proves: {', '.join(entry['proves'])}",
        f"- Result: {entry['result']}",
        f"- Artifacts: {', '.join(entry['artifact_refs'])}",
        "",
    ])
pathlib.Path(smoke_md).write_text("\n".join(lines), encoding="utf-8")

if failures:
    raise SystemExit(1)
PY

echo "workcell-verify ok base_url=${BASE_URL}"
